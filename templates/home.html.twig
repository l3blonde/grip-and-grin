{% extends "base.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <style>
        /* Updated to newspaper-style layout with vertical article cards */
        .articles-section {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        .articles-list {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .article-card {
            background: #ffffff;
            border-bottom: 1px solid #e5e5e5;
            padding-bottom: 2rem;
            transition: all 0.2s ease;
        }

        .article-card:hover {
            border-bottom-color: #cccccc;
        }

        .article-card:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .article-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            background: #f5f5f5;
            border-radius: 4px;
            margin-bottom: 1rem;
        }

        .article-content {
            padding: 0;
        }

        .article-category {
            display: inline-block;
            background: #000000;
            color: #ffffff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
        }

        .article-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #000000;
            margin-bottom: 0.75rem;
            line-height: 1.3;
            font-family: Georgia, 'Times New Roman', serif;
        }

        .article-title:hover {
            color: #333333;
        }

        .article-excerpt {
            color: #666666;
            line-height: 1.6;
            margin-bottom: 1rem;
            font-size: 1rem;
            font-family: Georgia, 'Times New Roman', serif;
        }

        .article-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid #f5f5f5;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .article-date {
            font-size: 0.875rem;
            color: #999999;
            font-weight: 400;
        }

        .read-more {
            background: #000000;
            color: #ffffff;
            padding: 8px 16px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.875rem;
            transition: background-color 0.2s ease;
        }

        .read-more:hover {
            background: #333333;
        }

        .no-articles {
            text-align: center;
            padding: 4rem 2rem;
            color: #666666;
        }

        .no-articles h3 {
            color: #000000;
            margin-bottom: 1rem;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
            margin-top: 3rem;
            padding: 2rem 0;
            flex-wrap: wrap;
        }

        .pagination a,
        .pagination span {
            padding: 8px 12px;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            text-decoration: none;
            color: #666666;
            transition: all 0.2s ease;
            font-size: 0.875rem;
            min-width: 40px;
            text-align: center;
        }

        .pagination a:hover {
            background: #f5f5f5;
            border-color: #cccccc;
        }

        .pagination .current {
            background: #000000;
            color: #ffffff;
            border-color: #000000;
        }

        .pagination .disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            .articles-section {
                padding: 1.5rem 1rem;
            }

            .article-image {
                height: 200px;
            }

            .article-title {
                font-size: 1.25rem;
            }

            .article-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
        }
    </style>

    <section class="articles-section">
        <div class="articles-list">
            {% for article in articles %}
                <article class="article-card">
                    {% if article.imagePath %}
                        <img src="{{ article.imagePath }}" alt="Article image" class="article-image">
                    {% endif %}

                    <div class="article-content">
                        {% if article.categoryName %}
                            <span class="article-category">{{ article.categoryName }}</span>
                        {% endif %}

                        <h3 class="article-title">{{ article.title }}</h3>
                        <p class="article-excerpt">{{ article.excerpt }}</p>

                        <div class="article-meta">
                            <span class="article-date">{{ article.createdAt|date('M j, Y') }}</span>
                            <!-- Fixed to use article slug instead of ID for SEO-friendly URLs -->
                            <a href="/article/{{ article.slug }}" class="read-more">Read More</a>
                        </div>
                    </div>
                </article>
            {% else %}
                <div class="no-articles">
                    <h3>No articles found</h3>
                    <p>Check back later for new content!</p>
                </div>
            {% endfor %}
        </div>

        <!-- Added pagination functionality for multiple pages -->
        {% if totalPages > 1 %}
            <div class="pagination">
                {% if hasPreviousPage %}
                    <a href="?page={{ previousPage }}">← Previous</a>
                {% else %}
                    <span class="disabled">← Previous</span>
                {% endif %}

                {% for page in 1..totalPages %}
                    {% if page == currentPage %}
                        <span class="current">{{ page }}</span>
                    {% else %}
                        <a href="?page={{ page }}">{{ page }}</a>
                    {% endif %}
                {% endfor %}

                {% if hasNextPage %}
                    <a href="?page={{ nextPage }}">Next →</a>
                {% else %}
                    <span class="disabled">Next →</span>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}

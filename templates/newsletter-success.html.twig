{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <style>
        .success-container {
            max-width: 600px;
            margin: 80px auto;
            padding: 40px 20px;
            text-align: center;
        }

        .success-icon {
            width: 80px;
            height: 80px;
            background: #000000;
            border-radius: 50%;
            margin: 0 auto 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 40px;
        }

        .success-title {
            font-size: 32px;
            font-weight: 600;
            color: #000000;
            margin-bottom: 20px;
        }

        .success-message {
            font-size: 18px;
            color: #666666;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .success-email {
            font-weight: 600;
            color: #000000;
        }

        .back-button {
            display: inline-block;
            background: #000000;
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 500;
            transition: background-color 0.3s;
        }

        .back-button:hover {
            background: #333333;
            color: white;
        }
    </style>

    <div class="success-container">
        <div class="success-icon">✓</div>
        <h1 class="success-title">Successfully Subscribed!</h1>
        <p class="success-message">
            Thank you for subscribing to Grip & Grin Magazine.<br>
            We've added <span class="success-email">{{ email }}</span> to our newsletter list.
        </p>
        <p class="success-message">
            You'll receive our latest classic car news, reviews, and exclusive content directly in your inbox.
        </p>
        <a href="/" class="back-button">Back to Homepage</a>
    </div>
{% endblock %}

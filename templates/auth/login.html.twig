{% extends "base.html.twig" %}

{% block title %}Admin Login | Grip & Grin{% endblock %}

{% block content %}
    <style>
        /* Minimalistic vertical login form for admin access */
        .login-container {
            max-width: 300px;
            margin: 80px auto;
            padding: 0 20px;
        }

        .login-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .admin-notice {
            text-align: center;
            margin-bottom: 30px;
            padding: 15px;
            background: #f5f5f5;
            border-radius: 4px;
            font-size: 14px;
            color: #666;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .form-group input {
            padding: 12px 0;
            border: none;
            border-bottom: 1px solid #ccc;
            background: transparent;
            font-size: 16px;
            color: #000;
            outline: none;
            transition: border-color 0.2s;
        }

        .form-group input:focus {
            border-bottom-color: #000;
        }

        .login-button {
            padding: 16px 0;
            background: #000;
            color: white;
            border: none;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            margin-top: 20px;
            transition: background-color 0.2s;
        }

        .login-button:hover {
            background: #333;
        }

        .error-message {
            color: #d32f2f;
            font-size: 12px;
            text-align: center;
            margin-bottom: 20px;
            padding: 10px;
            background: #ffebee;
            border-radius: 4px;
        }

        .back-link {
            text-align: center;
            margin-top: 40px;
        }

        .back-link a {
            color: #666;
            text-decoration: none;
            font-size: 12px;
        }

        .back-link a:hover {
            text-decoration: underline;
        }
    </style>

    <div class="login-container">
        <div class="admin-notice">
            <strong>Staff Access Only</strong><br>
            This login is for administrators and editors only.
        </div>

        {% if error %}
            <div class="error-message">{{ error }}</div>
        {% endif %}

        <form method="POST" action="/login" class="login-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="form-group">
                <label for="email_or_username">Email or Username</label>
                <input type="text" id="email_or_username" name="email_or_username"
                       value="{{ email_or_username|default('') }}" required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>

            <button type="submit" class="login-button">Login to Admin Panel</button>
        </form>

        <div class="back-link">
            <a href="/">← Back to Home</a>
        </div>
    </div>
{% endblock %}

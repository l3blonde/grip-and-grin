<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Dashboard{% endblock %} - Grip & Grin</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #ffffff;
            color: #000000;
            line-height: 1.5;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            background: #f8f9fa;
            border-right: 1px solid #e5e5e5;
            padding: 2rem 0;
        }

        .sidebar-header {
            padding: 0 2rem 2rem;
            border-bottom: 1px solid #e5e5e5;
            margin-bottom: 2rem;
        }

        .sidebar-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #000000;
        }

        .sidebar-nav {
            list-style: none;
        }

        .sidebar-nav li {
            margin-bottom: 0.5rem;
        }

        .sidebar-nav a {
            display: block;
            padding: 0.75rem 2rem;
            color: #666666;
            text-decoration: none;
            transition: all 0.2s;
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active {
            background: #e9ecef;
            color: #000000;
        }

        .main-content {
            flex: 1;
            padding: 2rem;
        }

        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e5e5e5;
            display: flex; /* Added flex layout for header with button */
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 600;
            color: #000000;
        }

        .btn {
            display: inline-block;
            padding: 0.5rem 1rem;
            border: 1px solid #000000;
            background: #ffffff;
            color: #000000;
            text-decoration: none;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn:hover {
            background: #000000;
            color: #ffffff;
        }

        .btn-danger {
            border-color: #666666;
            color: #666666;
        }

        .btn-danger:hover {
            background: #666666;
            color: #ffffff;
        }

        .btn-small {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }

        .table th,
        .table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid #e5e5e5;
        }

        .table th {
            background: #f8f9fa;
            font-weight: 600;
            color: #000000;
        }

        .table td {
            color: #666666;
        }

        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
            border-radius: 2px;
        }

        .status-published {
            background: #000000;
            color: #ffffff;
        }

        .status-draft {
            background: #e5e5e5;
            color: #666666;
        }

        .actions {
            display: flex;
            gap: 0.5rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            padding: 1.5rem;
            border: 1px solid #e5e5e5;
            background: #ffffff;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 600;
            color: #000000;
        }

        .stat-label {
            color: #666666;
            font-size: 0.875rem;
        }
    </style>
    <!-- Added styles block for child templates to inject custom CSS -->
    {% block styles %}{% endblock %}
</head>
<body>
<div class="admin-container">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h1 class="sidebar-title">Admin Panel</h1>
        </div>
        <ul class="sidebar-nav">
            <!-- Updated navigation routing to match consistent admin-* pattern -->
            <li><a href="/admin-dashboard" class="{% if app.request.pathinfo == '/admin-dashboard' %}active{% endif %}">Dashboard</a></li>
            <li><a href="/admin-articles" class="{% if '/articles' in app.request.pathinfo %}active{% endif %}">Articles</a></li>
            <li><a href="/admin-users" class="{% if '/users' in app.request.pathinfo %}active{% endif %}">Users</a></li>
            <li><a href="/admin-admins" class="{% if '/admins' in app.request.pathinfo %}active{% endif %}">Admins</a></li>
            <li><a href="/admin-gdpr-requests" class="{% if '/gdpr' in app.request.pathinfo %}active{% endif %}">GDPR Requests</a></li>
            <!-- Added My Profile link for admin/editor profile management -->
            <li><a href="/admin-profile" class="{% if '/admin-profile' in app.request.pathinfo %}active{% endif %}">My Profile</a></li>
            <li><a href="/" style="margin-top: 2rem; border-top: 1px solid #e5e5e5; padding-top: 1rem;">← Back to Site</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </nav>

    <main class="main-content">
        {% block content %}{% endblock %}
    </main>
</div>
</body>
</html>

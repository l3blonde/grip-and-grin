{% extends "admin/layout.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="admin-content">
    <div class="admin-header">
        <h1>{{ title }}</h1>
        <a href="/admin/articles/create" class="btn btn-primary">+ Create Article</a>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                <tr>
                    <td>{{ article.title }}</td>
                    <td>{{ article.categoryName ?: 'Uncategorized' }}</td>
                    <td>
                        <span class="status {{ article.isPublished ? 'published' : 'draft' }}">
                            {{ article.isPublished ? 'Published' : 'Draft' }}
                        </span>
                    </td>
                    <td>{{ article.createdAt|date('M j, Y') }}</td>
                    <td class="actions">
                        <a href="/admin/articles/edit?id={{ article.id }}" class="btn btn-small">Edit</a>
                        
                        <form method="POST" action="/admin/articles/toggle-status" style="display: inline;">
                            <input type="hidden" name="article_id" value="{{ article.id }}">
                            <button type="submit" class="btn btn-small btn-secondary">
                                {{ article.isPublished ? 'Unpublish' : 'Publish' }}
                            </button>
                        </form>
                        
                        <form method="POST" action="/admin/articles/delete" style="display: inline;" 
                              onsubmit="return confirm('Are you sure you want to delete this article?')">
                            <input type="hidden" name="article_id" value="{{ article.id }}">
                            <button type="submit" class="btn btn-small btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="no-data">No articles found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
